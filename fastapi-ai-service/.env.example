# =============================================================================
# SEIS AI Service — environment variable template
# =============================================================================
#
# Copy to `.env` for local development:   cp .env.example .env
# Never commit the real `.env` file (enforced by .gitignore; see §26.3
# Secrets Management in docs/week1-ai-system-design.md).
#
# Every variable below maps 1:1 to a field on `app.config.settings.Settings`
# (Task 4) — same name, same default. This file is the frozen environment
# variable contract; do not rename, remove, or add variables here without
# also changing Settings, and vice versa.
#
# Legend used in the comments:
#   [secret]   never commit a real value; required only when SERVICE_ENV=production
#   [required in prod]   Settings raises a validation error at startup if blank
#                         while SERVICE_ENV=production; optional otherwise
#   [docker]   this value typically needs to change when running under
#              docker-compose instead of bare-metal/local — see the Docker
#              Compatibility note near the bottom of this file
#
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION — service identity, network port, inbound auth (§19.2)
# -----------------------------------------------------------------------------

# One of: development | testing | staging | production (Environment enum).
# Drives log rendering (console vs JSON, §19.8) and gates the production
# secrets check below. Keep this as `development` for local work.
SERVICE_ENV=development

# Port uvicorn binds to. Valid range: 1024-65535 (non-privileged ports only).
SERVICE_PORT=8000

# [secret][required in prod] Service-to-service auth token Express must
# present on every request (§26.1-§26.2). The auth guard that checks this
# is not implemented yet (Task 8) — this variable already exists so the
# contract is stable when that guard lands.
INTERNAL_API_KEY=


# -----------------------------------------------------------------------------
# GEMINI — answer-generation LLM only (§19.3, ADR-003). Embeddings no
# longer use Gemini — see the NVIDIA EMBEDDINGS section below (ADR-007).
# -----------------------------------------------------------------------------

# [secret][required in prod] Never commit a real key. Get one from
# Google AI Studio / Vertex AI and set it in your local, git-ignored `.env`.
GEMINI_API_KEY=

# Pinned, not "latest" — prevents silent behavior drift if the provider
# changes its default model underneath you (§19.3).
GEMINI_MODEL_NAME=gemini-2.5-flash

# Valid range: 0.0-2.0. Low on purpose: grounded, factual RAG answers
# should not be creative (§19.3).
GEMINI_TEMPERATURE=0.2

# Must be > 0. Bounds generation cost/latency per call.
GEMINI_MAX_OUTPUT_TOKENS=2048

# Must be > 0. Feeds the circuit breaker described in §14.2.
GEMINI_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# NVIDIA EMBEDDINGS — FINAL embedding provider (ADR-007). Hosted inference
# only: Nemotron-3-Embed-1B is never downloaded or loaded inside this
# process/container, and this service never requires a GPU. Supersedes
# Gemini Embeddings (`text-embedding-004`, retired) from ADR-003.
# -----------------------------------------------------------------------------

# [secret][required to actually embed] Never commit a real key. Get one
# from build.nvidia.com and set it in your local, git-ignored `.env`.
# A blank value never crashes app boot — only an actual embed call fails,
# with a clear EmbeddingError, if this is missing (§21 lazy-client rule).
NVIDIA_API_KEY=

# NVIDIA's documented hosted-inference base URL (OpenAI-compatible NIM
# host). [docker] Unlike CHROMA_HOST/TASK_QUEUE_BROKER_URL, this does NOT
# need to change under docker-compose — it's an external HTTPS endpoint,
# not a container service name.
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1

# Must be > 0. Feeds the same per-request timeout pattern as GEMINI_TIMEOUT_MS.
NVIDIA_EMBEDDING_TIMEOUT_MS=30000

# Documents the model in use; the actual value NemotronEmbedder sends is
# pinned as a module constant in app/core/embedding/embedder.py (a model
# change must be a deliberate code change, not a silent `.env` edit —
# same reasoning GEMINI_MODEL_NAME's own comment above gives).
EMBEDDING_MODEL_NAME=nvidia/nemotron-3-embed-1b

# Manually bumped whenever EMBEDDING_MODEL_NAME changes. Stamped into every
# chunk's metadata and into the ChromaDB collection itself — mixing vectors
# from two different embedding-model versions in one collection silently
# breaks retrieval quality, so a model change must be a deliberate re-embed,
# never an in-place swap (§5.4, §19.4).
EMBEDDING_MODEL_VERSION=v1

# Nemotron-3-Embed-1B's native output size, verified from NVIDIA's official
# model card (docs.api.nvidia.com/nim/reference/nvidia-nemotron-3-embed-1b)
# — never assumed. Every stored/query vector is validated against this.
EMBEDDING_DIMENSION=2048

# Must be > 0. Chunks per batched embedding call (throughput tuning).
EMBEDDING_BATCH_SIZE=32

# Must be >= 0. 604800 = 7 days.
EMBEDDING_CACHE_TTL_SECONDS=604800


# -----------------------------------------------------------------------------
# NVIDIA RERANKING — hosted cross-encoder reranker (Task 24). Reuses
# NVIDIA_API_KEY and NVIDIA_EMBEDDING_TIMEOUT_MS above — no new secret, no
# local model, no GPU. Hosted inference only.
# -----------------------------------------------------------------------------

# [docker] Verified live against NVIDIA's real hosted API to be a
# *different host* than NVIDIA_EMBEDDING_BASE_URL — this reranking model
# is served from ai.api.nvidia.com, not integrate.api.nvidia.com (which
# 404s for this model's ranking endpoint). Does not need to change under
# docker-compose — it's an external HTTPS endpoint, not a container
# service name. The model-specific URL path is pinned as a code constant
# in app/core/retrieval/rag_optimizer.py, not configured here, the same
# reasoning EMBEDDING_MODEL_NAME's own comment above gives.
NVIDIA_RERANKING_BASE_URL=https://ai.api.nvidia.com


# -----------------------------------------------------------------------------
# CHROMADB — vector store connection (§19; §5.5). [docker]
# -----------------------------------------------------------------------------

# [docker] `localhost` is correct for bare-metal/local-venv development
# only. Under docker-compose this MUST become the Chroma service's
# container name (e.g. `chromadb`) — container networking has no
# `localhost` shared between services. See the Docker note below.
CHROMA_HOST=localhost

# Deliberately 8001, not ChromaDB's own default of 8000 — this service's
# own SERVICE_PORT is already 8000, and running both processes locally
# without Docker would otherwise collide on the same port.
CHROMA_PORT=8001

# Local persistence directory for a non-server (embedded) Chroma client.
# Ignored if you run Chroma as its own server process/container.
CHROMA_PERSIST_DIR=./.chroma


# -----------------------------------------------------------------------------
# QUEUE & CACHE — Redis-backed by default (§19.2). [docker]
# -----------------------------------------------------------------------------

# [docker] Backs the async task queue that decouples repository processing
# from request handling (§3.2). `localhost` -> the Redis service's
# container name under docker-compose (e.g. `redis://redis:6379/0`).
TASK_QUEUE_BROKER_URL=redis://localhost:6379/0

# One of: memory | redis. `memory` is fine for a single local process;
# use `redis` once more than one worker/instance needs to share a cache.
CACHE_BACKEND=memory

# Must be >= 0.
CACHE_TTL_SECONDS=3600


# -----------------------------------------------------------------------------
# RETRIEVER (§19.6) — starting defaults only; the Retriever itself
# (app/core/retrieval/retriever.py) is a Week 4 deliverable (§25). Expect
# these to be re-tuned empirically once the AI Evaluation Framework (§24.5
# Top-K sweep) has real precision/recall data to tune against.
# -----------------------------------------------------------------------------

# Must be > 0. Baseline retrieval breadth before reranking.
RETRIEVER_DEFAULT_TOP_K=8

# Valid range: 0.0-1.0. Chunks scoring below this are dropped rather than
# padding the prompt with low-relevance context.
RETRIEVER_SIMILARITY_THRESHOLD=0.35


# -----------------------------------------------------------------------------
# LOGGING (§15, §19.8)
# -----------------------------------------------------------------------------

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# NOTE: this file sets DEBUG (recommended for local dev, §19.8's
# environment table) — this intentionally differs from the safe INFO
# baseline that `Settings` falls back to in code when no `.env` is present
# at all (§19.1 layering: code default vs. this file's per-environment
# recommendation are two different layers, not a bug).
LOG_LEVEL=DEBUG

# One of: stdout | file. Use `stdout` in every containerized environment
# (the platform's log collector reads it, §19.8); `file` is a local-only
# debugging convenience that writes rotating logs to ./logs/.
LOG_SINK=stdout

# Valid range: 0.0-1.0. Fraction of DEBUG-level events actually emitted;
# 1.0 = log every DEBUG event (fine at local scale). Lower this in a
# high-traffic environment before ever setting LOG_LEVEL=DEBUG there.
LOG_SAMPLING_RATE=1.0


# -----------------------------------------------------------------------------
# FEATURE FLAGS (§19.9) — booleans, safe to toggle per environment without
# a code change. See §19.9 for what each flag gates.
# -----------------------------------------------------------------------------

FEATURE_QUERY_REWRITE=true
FEATURE_RERANKING=true
FEATURE_RESPONSE_CACHE=true
# Off by default: BaseHTTPMiddleware (app/main.py's ObservabilityMiddleware)
# has known interaction issues with streamed responses. Leave this false
# until that's specifically re-verified when Repository Chat adds
# streaming support.
FEATURE_STREAMING_CHAT=false
FEATURE_EVOLUTION_ANALYSIS=true
FEATURE_INCREMENTAL_REINDEX=true


# =============================================================================
# Docker Compatibility Notes
# =============================================================================
# Variables that name a network location default to `localhost` for local,
# non-containerized development, and need a docker-compose override:
#
#   CHROMA_HOST              -> the Chroma service's container name
#   TASK_QUEUE_BROKER_URL    -> redis://<redis-service-name>:6379/0
#
# SERVICE_PORT (8000) is what the container listens on internally; map it
# to a host port in docker-compose.yml's `ports:` section rather than
# changing this value. CHROMA_PERSIST_DIR should be backed by a named
# volume when Chroma runs as an embedded (non-server) client inside a
# container, so data survives a container restart.
#
# This file does not hardcode any Windows-specific path — CHROMA_PERSIST_DIR
# uses a relative POSIX-style path that works unchanged on Linux containers.
