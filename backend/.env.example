# Native backend development. Render receives these values through its secret UI.
PORT=5000
NODE_ENV=development
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
JWT_SECRET=<random-secret>
JWT_REFRESH_SECRET=<different-random-secret>
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback?redirect=true
FRONTEND_URL=http://localhost:5173
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_API_KEY=<same-value-as-fastapi-INTERNAL_API_KEY>
