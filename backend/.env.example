# =============================================================================
# SEIS AI Express Backend — Environment Configuration Template
# =============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection (Local or Atlas URI)
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URL=mongodb://127.0.0.1:27017

# JWT Authentication
JWT_SECRET=seis_ai_jwt_development_secret_change_in_production
JWT_REFRESH_SECRET=seis_ai_jwt_refresh_development_secret_change_in_production
JWT_EXPIRES_IN=7d

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# FastAPI AI Service Integration
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_API_KEY=
FASTAPI_TIMEOUT_MS=15000
FASTAPI_CHAT_TIMEOUT_MS=75000
FASTAPI_MAX_RETRIES=3
FASTAPI_RETRY_BASE_DELAY_MS=500

# Email Service (Optional for local dev)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="SEIS-AI" <no-reply@seis-ai.local>
